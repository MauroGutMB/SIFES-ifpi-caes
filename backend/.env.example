# Environment variables declared in this file are NOT automatically loaded by Prisma.
# prisma7.config.ts já importa "dotenv/config", então este arquivo é lido normalmente.

# Em produção, inclua "?sslmode=require" na connection string.
DATABASE_URL="postgresql://sifes:sifes@localhost:5432/sifes?schema=public"

# JWT
JWT_ACCESS_SECRET="troque-este-valor-em-producao"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-outro-valor-em-producao"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie do refresh token — em produção (frontend e backend em domínios diferentes,
# isso PRECISA ser "true", senão o cookie sai sem
# Secure/SameSite=None e o navegador descarta em toda chamada cross-site.
COOKIE_SECURE="false"

# Origem exata do frontend (sem barra no final) — usada no CORS. Em produção,
WEB_ORIGIN="http://localhost:5173"

PORT=3000
